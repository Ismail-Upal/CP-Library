KMP String pattern matching algorithms:
----------------------------------------------------------------
vector<int> LPS(string pattern){
    int m = pattern.size();
    vector<int> lps(m, 0);

    int l = 0;
    int r = 1;

    while(r < m){
        if(pattern[l] == pattern[r]){
            l++;
            lps[r] = l;
            r++;
        }
        else{
            if(l != 0){
                l = lps[l - 1];
            }
            else{
                lps[r] = 0;
                r++;
            }
        }
    }

    return lps;
}
void KMP(string text, string pattern){
    int n = text.length();
    int m = pattern.length();

    if(m == 0) return;

    vector<int> lps = LPS(pattern);

    int i = 0, j = 0;

    while(i < n){
        if(pattern[j] == text[i]){
            i++, j++;
        }

        if(j == m){
            // cout << "starts: " << i - j << endl;
            j = lps[j - 1];
        }
        else if(i < n and pattern[j] != text[i]){
            if(j != 0){
                j = lps[j - 1];
            }
            else{
                i++;
            }
        }
    }
}

void Solve(){
    string s, t; 
    cin >> s >> t;
    KMP(s, t); cout << endl;
}
